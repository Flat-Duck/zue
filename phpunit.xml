<?xml version="1.0" encoding="UTF-8"?>
<phpunit defaultTestSuite="Application" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Application">
            <directory>tests/Unit</directory>
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Representative volume benchmarks. Excluded from the default run
            because they seed six figure row counts; run them explicitly with
            the Performance testsuite.
        -->
        <testsuite name="Performance">
            <directory>tests/Performance</directory>
        </testsuite>
    </testsuites>


    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            A real broadcaster, so channel authorization actually runs. Under the
            `null` driver `/broadcasting/auth` answers 200 with an empty body for
            anyone, and a test asserting who may subscribe would prove nothing.
        -->
        <env name="BROADCAST_DRIVER" value="reverb"/>
        <env name="REVERB_APP_ID" value="testing"/>
        <env name="REVERB_APP_KEY" value="testing-key"/>
        <env name="REVERB_APP_SECRET" value="testing-secret"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
