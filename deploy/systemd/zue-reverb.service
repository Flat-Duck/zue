# The WebSocket server behind live notifications. The browser connects to it
# over wss:// through the web server, so the web server terminates TLS with the
# same certificate and proxies /app to this port.
#
#   sudo cp deploy/systemd/zue-reverb.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now zue-reverb

[Unit]
Description=zue reverb websocket server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/zue
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=5
StandardOutput=append:/var/www/zue/storage/logs/reverb.log
StandardError=append:/var/www/zue/storage/logs/reverb.log

[Install]
WantedBy=multi-user.target
