includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Level 6 adds missing-type reporting: parameters, properties, return types and
    # the value types inside arrays and collections. Raising it caught 712 places;
    # 451 were fixed outright — a trait whose scopes crashed on fourteen models,
    # seventy-seven untyped relations, thirty form request rule sets and forty-eight
    # controller return types. The remainder is baselined below and is a long tail of
    # untyped parameters, visible and enumerated rather than merely unreported.
    level: 6

    paths:
        - app
        - database
        - routes

    # Generated/legacy surfaces that are out of scope for the active application.
    excludePaths:
        - legacy-frontend (?)

    ignoreErrors:
        # Eloquent's dynamic query builder defeats static analysis in places
        # where the code is correct at runtime.
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder#'
